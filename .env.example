# =============================================================================
# SKBT Booking System 2026 — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# =============================================================================

# ----- Supabase (optional but recommended) -----
# Get these from https://app.supabase.com → Project Settings → API
# When BOTH are set, profiles and bookings sync to Supabase automatically.
# When EITHER is missing, the app falls back to localStorage (offline mode).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# ----- Admin login override (optional) -----
# Default credentials are admin / admin. Override here for production.
VITE_ADMIN_ID="admin"
VITE_ADMIN_PASSWORD="admin"

# ----- Telegram CTA (optional, v1.9.3+) -----
# Surfaced as in-app "Sertai grup Telegram" CTA on the scan result sheet,
# loans view, and settings page. If unset, falls back to the bot DM
# (https://t.me/TempahSKBT_bot). Set to empty string to hide the CTA
# entirely. Recommended: paste your group invite link (Admin → group
# settings → "Invite via Link" → copy).
VITE_TELEGRAM_INVITE_URL="https://t.me/+YOUR_GROUP_INVITE_HASH"
VITE_TELEGRAM_GROUP_LABEL="Tempah@SKBT"

# ----- Gemini AI (legacy, optional) -----
# Required only if you re-enable Gemini-powered features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ----- App URL (auto-injected by AI Studio) -----
APP_URL="MY_APP_URL"

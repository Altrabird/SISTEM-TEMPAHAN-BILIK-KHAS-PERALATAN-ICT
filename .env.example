# =============================================================================
# SKBT Booking System 2026 — Environment Variables
# Copy this file to `.env.local` and fill in the values.
# =============================================================================

# ----- Supabase (optional but recommended) -----
# Get these from https://app.supabase.com → Project Settings → API
# When BOTH are set, profiles and bookings sync to Supabase automatically.
# When EITHER is missing, the app falls back to localStorage (offline mode).
VITE_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_PUBLIC_ANON_KEY"

# ----- Gemini AI (legacy, optional) -----
# Required only if you re-enable Gemini-powered features.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# ----- App URL (auto-injected by AI Studio) -----
APP_URL="MY_APP_URL"
